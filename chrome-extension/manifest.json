{
  "manifest_version": 3,
  "name": "VeriCargo Gmail Shipping Assistant",
  "short_name": "VeriCargo",
  "version": "0.9.3",
  "description": "Review shipping emails and compare Shipping Instructions with Draft Bills of Lading beside Gmail.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://vericargo-api-8562721906.asia-southeast1.run.app/*"],
  "action": {
    "default_title": "Open VeriCargo"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
